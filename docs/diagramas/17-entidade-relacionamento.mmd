    USUARIO {
        uuid id PK
        varchar nome_completo
        varchar nome_usuario UK
        varchar email UK
        varchar senha_hash
        date data_nascimento
        varchar status
        timestamptz data_cadastro
    }
    ATIVIDADE {
        uuid id PK
        uuid usuario_id FK
        uuid categoria_id FK
        varchar titulo
        date data_atividade
        time hora_inicio
        time hora_fim
        varchar prioridade
        varchar status
    }
    TRANSACAO {
        uuid id PK
        uuid usuario_id FK
        uuid conta_id FK
        uuid categoria_id FK
        varchar descricao
        varchar tipo
        numeric valor
        date data_movimento
    }
    IMPORTANCIA {
        uuid id PK
        uuid usuario_id FK
        uuid categoria_id FK
        varchar titulo
        varchar origem
        date data_vencimento
        numeric valor
        varchar status
    }
    CONTA_FINANCEIRA {
        uuid id PK
        uuid usuario_id FK
        varchar nome
        varchar tipo
        numeric saldo_atual
    }
    CATEGORIA {
        uuid id PK
        uuid usuario_id FK
        uuid categoria_pai_id FK
        varchar nome
        varchar escopo
        varchar cor_hex
    }
